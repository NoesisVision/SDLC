{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "P3 Model Changes Schema",
  "description": "Schema for a list of P3 model changes including element and relation modifications",
  "type": "object",
  "properties": {
    "changes": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/definitions/ElementChange"
          },
          {
            "$ref": "#/definitions/RelationChange"
          }
        ]
      }
    }
  },
  "required": ["changes"],
  "definitions": {
    "ElementChange": {
      "type": "object",
      "properties": {
        "changeType": {
          "type": "string",
          "const": "element"
        },
        "elementType": {
          "type": "string",
          "enum": ["DomainBehavior", "DomainObject", "DomainModule"]
        },
        "operation": {
          "type": "string",
          "enum": ["Create", "Update", "Delete"]
        },
        "elementId": {
          "type": "string",
          "description": "ID of the existing element (required for Update and Delete operations)"
        },
        "name": {
          "type": "string",
          "description": "Name of the element (required for Create operations)"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "businessRules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "required": ["name", "description"]
          },
          "description": "Required for DomainBehavior changes"
        },
        "bddScenarios": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Array of BDD scenarios, required for DomainBehavior changes"
        }
      },
      "required": ["changeType", "elementType", "operation"],
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "enum": ["Update", "Delete"]
              }
            }
          },
          "then": {
            "required": ["elementId"]
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "Create"
              }
            }
          },
          "then": {
            "required": ["name", "tags"]
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "Update"
              }
            }
          },
          "then": {
            "required": ["tags"]
          }
        },
        {
          "if": {
            "properties": {
              "elementType": {
                "const": "DomainBehavior"
              },
              "operation": {
                "enum": ["Create", "Update"]
              }
            }
          },
          "then": {
            "required": ["businessRules", "bddScenarios"]
          }
        }
      ]
    },
    "RelationChange": {
      "type": "object",
      "properties": {
        "changeType": {
          "type": "string",
          "const": "relation"
        },
        "operation": {
          "type": "string",
          "enum": ["Create", "Delete"]
        },
        "sourceId": {
          "type": "string"
        },
        "destinationId": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "DomainBehavior.InvokesBehavior",
            "DomainBehavior.UsesObject",
            "DomainModule.ContainsDomainModule",
            "DomainModule.ContainsObject",
            "DomainModule.ContainsBehavior",
            "DomainObject.ContainsBehavior",
            "DomainObject.UsesObject"
          ],
          "description": "Type of the P3 relation"
        }
      },
      "required": ["changeType", "operation", "sourceId", "destinationId", "type"]
    }
  }
}
