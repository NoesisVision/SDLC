{
  "$defs": {
    "Actor": {
      "description": "A person, system, or role that interacts with the domain.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        }
      },
      "required": [
        "name"
      ],
      "title": "Actor",
      "type": "object"
    },
    "BehaviorType": {
      "enum": [
        "Command",
        "Event",
        "Query"
      ],
      "title": "BehaviorType",
      "type": "string"
    },
    "Behaviour": {
      "description": "An operation or action that a building block can perform.",
