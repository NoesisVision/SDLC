        "input": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChangeSet_str_"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Input BuildingBlock names"
        },
        "output": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChangeSet_str_"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Output BuildingBlock names"
        },
        "usedBuildingBlocks": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChangeSet_str_"
            },
            {
              "type": "null"
            }
