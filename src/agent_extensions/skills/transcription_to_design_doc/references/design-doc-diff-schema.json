          "default": null,
          "description": "Name of the actor who initiates this behaviour",
          "title": "Actor"
        }
      },
      "required": [
        "name"
      ],
      "title": "Behaviour",
      "type": "object"
    },
    "BoundedContext": {
      "description": "Modification of a BoundedContext.\n\nWhen used in `added`: all scalar fields must be populated.\nWhen used in `modified`: only changed fields are set (None = no change).",
