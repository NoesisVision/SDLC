{
  "name": "@noesis/sdlc-tools",
  "version": "1.0.0",
  "description": "TypeScript tooling for SDLC resources and validation",
  "type": "module",
  "private": true,
  "scripts": {
    "dev:backend": "cd src/agent_extensions/plugins/noesis && bun run mcp/noesis-graph/dev/dev-server.ts",
    "dev:all": "bun run src/agent_extensions/plugins/noesis/scripts/dev-all.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test:smoke": "bun run tests/agent_extensions/plugins/noesis/smoke/run-smoke.ts",
    "test:unit": "bun run tests/run-unit-tests.ts"
  },
  "devDependencies": {
    "prettier": "^3.8.3"
  }
}
