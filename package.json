{
  "name": "@noesis/sdlc-tools",
  "version": "1.0.0",
  "description": "TypeScript tooling for SDLC resources and validation",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist",
    "dev": "tsx",
    "dev:backend": "cd src/agent_extensions/plugins/noesis && bun run mcp/noesis-graph/dev/dev-server.ts",
    "dev:all": "bun run src/agent_extensions/plugins/noesis/scripts/dev-all.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "smoke:noesis": "bun run tests/agent_extensions/plugins/noesis/smoke/run-smoke.ts"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.4",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "ajv": "^8.12.0",
    "ajv-formats": "^3.0.1",
    "uuid": "^13.0.0",
    "zod": "^3.22.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
